@model tl2_tp6_2024_ElZorroAs.Models.Clientes

@{
    ViewData["Title"] = "Modificar Cliente";
}

<h2>Modificar Cliente</h2>

<form asp-action="ModificarCliente" method="post">
    <input type="hidden" name="idCliente" value="@Model.ClienteId" />
    <div class="form-group">
        <label for="nombre">Nombre:</label>
        <input type="text" name="nombre" class="form-control" value="@Model.Nombre" required />
    </div>
    <div class="form-group">
        <label for="email">Email:</label>
        <input type="email" name="email" class="form-control" value="@Model.Email" required />
    </div>
    <div class="form-group">
        <label for="telefono">Teléfono:</label>
        <input type="text" name="telefono" class="form-control" value="@Model.Telefono" required />
    </div>

    <button type="submit" class="btn btn-primary">Modificar Cliente</button>
    <a asp-action="ListarClientes" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model tl2_tp6_2024_ElZorroAs.ViewModels.AgregarProductoPresupuestoViewModel

<h2>Agregar Producto al Presupuesto</h2>

<form asp-action="AgregarProductoPresupuesto" asp-controller="Presupuestos" method="post">
    <input type="hidden" asp-for="IdPresupuesto" />
    
    <div class="form-group">
        <label>Producto</label>
        <select asp-for="ProductoId" asp-items="@(new SelectList(Model.ProductosDisponibles, "IdProducto", "Descripcion"))" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Cantidad</label>
        <input type="number" asp-for="Cantidad" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Agregar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

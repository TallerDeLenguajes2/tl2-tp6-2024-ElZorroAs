@model tl2_tp6_2024_ElZorroAs.Models.Clientes

@{
    ViewData["Title"] = "Crear Presupuesto";
}

<h2>Crear Presupuesto</h2>

<form asp-action="CrearPresupuesto" method="post">
    <div class="form-group">
        <label for="nombreDestinatario">Nombre del Cliente:</label>
        <input type="text" name="nombreDestinatario" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Crear Presupuesto</button>
    <a asp-action="ListarPresupuesto" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
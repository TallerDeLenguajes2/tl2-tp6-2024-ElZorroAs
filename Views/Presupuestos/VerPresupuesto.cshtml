@model tl2_tp6_2024_ElZorroAs.Models.Presupuestos

@{
    ViewData["Title"] = "Ver Presupuesto";
}

<h2>Ver Presupuesto</h2>

<div>
    <h4>ID Presupuesto: @Model.IdPresupuesto</h4>
    <h4>Cliente: @Model.Cliente.Nombre</h4>
    <h4>Fecha de Creación: @Model.FechaCreacion.ToShortDateString()</h4>
</div>

<h3>Detalles del Presupuesto</h3>
<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detalle in Model.Detalle)
        {
            <tr>
                <td>@detalle.Producto.Descripcion</td>
                <td>@detalle.Cantidad</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="ListarPresupuesto" class="btn btn-secondary">Volver a la Lista</a>
@* VerPresupuesto.cshtml *@
@model tl2_tp6_2024_ElZorroAs.Models.Presupuestos

<h2>Detalles del Presupuesto</h2>
<p><strong>Cliente:</strong> @Model.Cliente.Nombre</p>
<p><strong>Fecha:</strong> @Model.FechaCreacion.ToShortDateString()</p>
<h3>Productos</h3>
<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Detalle)
        {
            <tr>
                <td>@item.Producto.Descripcion</td>
                <td>@item.Cantidad</td>
                <td>@item.Producto.Precio</td>
            </tr>
        }
    </tbody>
</table>
@* ListarPresupuesto.cshtml *@
@model List<tl2_tp6_2024_ElZorroAs.Models.Presupuestos>

<h2>Listado de Presupuestos</h2>
<a href="@Url.Action("CrearPresupuesto", "Presupuestos")" class="btn btn-primary">Crear Presupuesto</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var presupuesto in Model)
        {
            <tr>
                <td>@presupuesto.IdPresupuesto</td>
                <td>@presupuesto.Cliente.Nombre</td>
                <td>@presupuesto.FechaCreacion.ToShortDateString()</td>
                <td>
                    <a href="@Url.Action("VerPresupuesto", "Presupuestos", new { id = presupuesto.IdPresupuesto })" class="btn btn-info">Ver</a>
                    <a href="@Url.Action("AgregarProducto", "Presupuestos", new { idPresupuesto = presupuesto.IdPresupuesto })" class="btn btn-success">Agregar Producto</a>
                    <a href="@Url.Action("ModificarPresupuesto", "Presupuestos", new { id = presupuesto.IdPresupuesto })" class="btn btn-warning">Modificar</a>
                    <a href="@Url.Action("EliminarPresupuesto", "Presupuestos", new { id = presupuesto.IdPresupuesto })" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

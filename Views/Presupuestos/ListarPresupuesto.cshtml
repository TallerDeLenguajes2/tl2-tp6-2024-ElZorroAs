@model IEnumerable<tl2_tp6_2024_ElZorroAs.Models.Presupuestos>

@{
    ViewData["Title"] = "Lista de Presupuestos";
}

<h2>Lista de Presupuestos</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Cliente</th>
            <th>Fecha de Creación</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var presupuesto in Model)
        {
            <tr>
                <td>@presupuesto.IdPresupuesto</td>
                <td>@presupuesto.Cliente.Nombre</td>
                <td>@presupuesto.FechaCreacion.ToShortDateString()</td>
                <td>
                    <a asp-action="VerPresupuesto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-info">Ver</a>
                    <a asp-action="AgregarProducto" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" class="btn btn-primary">Agregar Producto</a>
                    <a asp-action="EliminarPresupuesto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-danger" onclick="return confirm('¿Está seguro de que desea eliminar este presupuesto?');">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="CrearPresupuesto" class="btn btn-success">Crear Nuevo Presupuesto</a>